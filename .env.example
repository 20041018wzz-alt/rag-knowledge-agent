# ===== RAG 知识库问答 Agent 配置模板 =====
# 复制为 .env 后按需修改；不设置任何 Key 也能以 Mock 模式运行。

# ── LLM（对话生成）──
# 留空 = Mock 模式（确定性回复，适合演示/测试）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# ── Embedding（三选一）──
# mock：字符特征哈希向量，离线演示/测试（默认）
# api ：OpenAI 兼容 /embeddings，如 SiliconFlow 的 BGE 系列
# local：本地 sentence-transformers BGE（需能安装 torch）
EMBEDDING_BACKEND=mock
EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=BAAI/bge-m3

# ── 切分参数 ──
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MIN_CHUNK_LEN=20

# ── 检索 ──
TOP_K=4
# 相关性阈值：低于则判"无相关知识"。mock 后端建议 0.25；
# 切换 api/local 后端后建议上调（BGE 语义向量相关片段通常 > 0.5）。
RELEVANCE_THRESHOLD=0.25

# ── 向量库后端 ──
# auto    ：按 pgvector → Chroma → Memory 优先级自动降级（推荐）
# pgvector：生产默认，向量与业务数据同库，HNSW 索引
# chroma  ：本地开发 / 单机 Demo（零依赖，文件持久化）
# memory  ：纯 Python 兜底，离线演示与测试
VECTOR_STORE_BACKEND=auto
# pgvector 连接串；留空 = 跳过 pgvector 直接降级（不装数据库也能跑通全链路）
DATABASE_URL=
PGVECTOR_TABLE=knowledge_chunks
# 建表维度：0 = 由首次入库向量维度自动决定；显式指定可让索引在启动时就建好
PGVECTOR_DIM=0

# ── 日志 ──
LOG_LEVEL=INFO
